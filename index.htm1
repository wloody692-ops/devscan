<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>EUR/USD 1M</title>

<style>
body{
    margin:0;
    background:#07101d;
    color:white;
    font-family:Arial,sans-serif;
}

.box{
    max-width:600px;
    margin:auto;
    padding:15px;
}

.card{
    background:#111c2e;
    border-radius:18px;
    padding:20px;
    margin-bottom:15px;
    border:1px solid #263852;
}

h1{
    text-align:center;
    margin:0 0 5px;
}

.sub{
    text-align:center;
    color:#8c9bb3;
    font-size:13px;
}

.signal{
    text-align:center;
    padding:30px 10px;
    margin-top:18px;
    background:#091322;
    border-radius:15px;
}

.signalText{
    font-size:38px;
    font-weight:900;
}

.buy{color:#27e58b}
.sell{color:#ff5368}
.wait{color:#ffd166}

.reason{
    margin-top:10px;
    color:#b0bbcc;
    font-size:13px;
    line-height:1.7;
}

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:15px;
}

.item{
    background:#19263b;
    border-radius:12px;
    padding:13px;
    text-align:center;
}

.item small{
    display:block;
    color:#8492a9;
}

.item b{
    display:block;
    margin-top:5px;
    font-size:17px;
}

button{
    width:100%;
    margin-top:18px;
    padding:14px;
    border:0;
    border-radius:12px;
    background:#2864ff;
    color:white;
    font-size:16px;
    font-weight:bold;
}

.status{
    text-align:center;
    margin-top:12px;
    color:#8997ad;
    font-size:12px;
}

#error{
    color:#ff6678;
    text-align:center;
    margin-top:10px;
    font-size:12px;
}
</style>
</head>

<body>

<div class="box">

<div class="card">

<h1>EUR/USD — 1 دقيقة</h1>

<div class="sub">
RSI 7 + EMA 9/26 + اتجاه 5 دقائق
</div>

<div class="signal">

<div id="signal" class="signalText wait">
🟡 انتظار
</div>

<div id="reason" class="reason">
جاري التحليل...
</div>

</div>

<div class="grid">

<div class="item">
<small>السعر</small>
<b id="price">-</b>
</div>

<div class="item">
<small>RSI 7</small>
<b id="rsi">-</b>
</div>

<div class="item">
<small>EMA 9</small>
<b id="ema9">-</b>
</div>

<div class="item">
<small>EMA 26</small>
<b id="ema26">-</b>
</div>

<div class="item">
<small>اتجاه 5M</small>
<b id="trend">-</b>
</div>

<div class="item">
<small>آخر شمعة</small>
<b id="candle">-</b>
</div>

</div>

<button onclick="analyze()">
🔄 تحليل الآن
</button>

<div id="status" class="status">
جاري الاتصال...
</div>

<div id="error"></div>

</div>

</div>


<script>

/*
==================================================
ضع مفتاح Twelve Data هنا
==================================================
*/

const API_KEY = "ضع_مفتاحك_هنا";

const SYMBOL = "EUR/USD";


/*
==================================================
جلب بيانات EUR/USD
==================================================
*/

async function getData(){

    const url =
        "https://api.twelvedata.com/time_series" +
        "?symbol=" +
        encodeURIComponent(SYMBOL) +
        "&interval=1min" +
        "&outputsize=100" +
        "&format=JSON" +
        "&apikey=" +
        encodeURIComponent(API_KEY);

    const response = await fetch(url);

    if(!response.ok){
        throw new Error(
            "خطأ اتصال: " + response.status
        );
    }

    const data = await response.json();

    if(data.status === "error"){
        throw new Error(
            data.message || "خطأ في API"
        );
    }

    if(!data.values){
        throw new Error(
            "لم تصل شموع EUR/USD"
        );
    }

    return data.values.reverse();
}


/*
==================================================
EMA
==================================================
*/

function calculateEMA(values, period){

    if(values.length < period){
        return null;
    }

    let sum = 0;

    for(let i=0;i<period;i++){
        sum += values[i];
    }

    let ema = sum / period;

    const multiplier =
        2 / (period + 1);

    for(
        let i=period;
        i<values.length;
        i++
    ){

        ema =
            ((values[i] - ema) * multiplier)
            + ema;
    }

    return ema;
}


/*
==================================================
RSI 7
==================================================
*/

function calculateRSI(values, period=7){

    if(values.length <= period){
        return null;
    }

    let gain = 0;
    let loss = 0;

    for(let i=1;i<=period;i++){

        const change =
            values[i] - values[i-1];

        if(change > 0){
            gain += change;
        }else{
            loss += Math.abs(change);
        }
    }

    let avgGain =
        gain / period;

    let avgLoss =
        loss / period;

    for(
        let i=period+1;
        i<values.length;
        i++
    ){

        const change =
            values[i] - values[i-1];

        const currentGain =
            change > 0 ? change : 0;

        const currentLoss =
            change < 0
            ? Math.abs(change)
            : 0;

        avgGain =
            ((avgGain*(period-1))
            + currentGain) / period;

        avgLoss =
            ((avgLoss*(period-1))
            + currentLoss) / period;
    }

    if(avgLoss === 0){
        return 100;
    }

    const rs =
        avgGain / avgLoss;

    return 100 -
        (100 / (1 + rs));
}


/*
==================================================
اتجاه 5 دقائق
==================================================
*/

function calculateTrend(candles){

    /*
      نستخدم آخر 25 شمعة دقيقة
      ونقارن متوسط آخر 5
      بمتوسط 5 السابقة.
    */

    if(candles.length < 15){
        return "محايد";
    }

    const closes =
        candles.map(
            x => Number(x.close)
        );

    const last5 =
        closes.slice(-5);

    const previous5 =
        closes.slice(-10,-5);

    const avgLast =
        last5.reduce(
            (a,b)=>a+b,
            0
        ) / 5;

    const avgPrevious =
        previous5.reduce(
            (a,b)=>a+b,
            0
        ) / 5;

    if(avgLast > avgPrevious){
        return "صاعد";
    }

    if(avgLast < avgPrevious){
        return "هابط";
    }

    return "محايد";
}


/*
==================================================
الإشارة
==================================================
*/

function getSignal(
    rsi,
    ema9,
    ema26,
    trend
){

    /*
      شراء قوي:
      EMA9 فوق EMA26
      RSI 55 - 70
      اتجاه 5M صاعد
    */

    if(
        ema9 > ema26 &&
        rsi >= 55 &&
        rsi <= 70 &&
        trend === "صاعد"
    ){

        return {
            className:"buy",
            text:"🟢 شراء",
            reason:
            "توافق EMA 9/26 + RSI 7 + اتجاه 5M."
        };
    }


    /*
      بيع قوي:
      EMA9 تحت EMA26
      RSI 30 - 45
      اتجاه 5M هابط
    */

    if(
        ema9 < ema26 &&
        rsi >= 30 &&
        rsi <= 45 &&
        trend === "هابط"
    ){

        return {
            className:"sell",
            text:"🔴 بيع",
            reason:
            "توافق EMA 9/26 + RSI 7 + اتجاه 5M."
        };
    }


    return {
        className:"wait",
        text:"🟡 انتظار",
        reason:
        "الشروط القوية غير مكتملة."
    };
}


/*
==================================================
التحليل
==================================================
*/

async function analyze(){

    const status =
        document.getElementById("status");

    const error =
        document.getElementById("error");

    error.innerText = "";

    status.innerText =
        "⏳ جاري جلب البيانات...";


    try{

        if(
            !API_KEY ||
            API_KEY === "ضع_مفتاحك_هنا"
        ){

            throw new Error(
                "ضع API Key الخاص بك في الكود أولًا."
            );
        }


        const candles =
            await getData();


        const closes =
            candles.map(
                x => Number(x.close)
            );


        const price =
            closes[closes.length-1];


        const ema9 =
            calculateEMA(
                closes,
                9
            );


        const ema26 =
            calculateEMA(
                closes,
                26
            );


        const rsi =
            calculateRSI(
                closes,
                7
            );


        const trend =
            calculateTrend(
                candles
            );


        const result =
            getSignal(
                rsi,
                ema9,
                ema26,
                trend
            );


        /*
        عرض البيانات
        */

        document.getElementById("price")
            .innerText =
            price.toFixed(5);


        document.getElementById("rsi")
            .innerText =
            rsi.toFixed(2);


        document.getElementById("ema9")
            .innerText =
            ema9.toFixed(5);


        document.getElementById("ema26")
            .innerText =
            ema26.toFixed(5);


        document.getElementById("trend")
            .innerText =
            trend;


        document.getElementById("candle")
            .innerText =
            candles[
                candles.length-1
            ].datetime;


        /*
        الإشارة
        */

        const signal =
            document.getElementById(
                "signal"
            );


        signal.innerText =
            result.text;


        signal.className =
            "signalText " +
            result.className;


        document.getElementById("reason")
            .innerText =
            result.reason;


        status.innerText =
            "✅ تم التحديث " +
            new Date()
            .toLocaleTimeString("ar-SA");

    }


    catch(e){

        status.innerText =
            "❌ لم يتم التحليل";

        error.innerText =
            e.message;

    }
}


/*
==================================================
تشغيل أول مرة
==================================================
*/

analyze();


/*
==================================================
تحديث كل 60 ثانية
==================================================
*/

setInterval(
    analyze,
    60000
);

</script>

</body>
</html>
